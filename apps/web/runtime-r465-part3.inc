function paintFYLoading(){const h=fyHost();if(!h)return false;h.innerHTML='<div data-ct465-foryou><section class="panel"><div class="empty">Buscando indicação…</div></section></div>';h.dataset.ct465Owned='1';document.documentElement.dataset.ct465ForYou='loading';return true}
function paintFYFailure(msg){const h=fyHost();if(!h)return false;h.innerHTML='<div data-ct465-foryou><section class="panel"><div class="empty">'+esc(msg)+' <button type="button" class="chip" data-ct465-fy-retry>Tentar novamente</button></div></section></div>';document.documentElement.dataset.ct465ForYou='error';return true}
async function fetchPool(group,kind){const name=group==='watch'?'cinetracker_discover_watch_unseen_v421':'cinetracker_discover_fresh_v421',limit=group==='watch'?30:48;const raw=unwrap(await timeout(rpcCall(name,{p_kind:kind,p_limit:limit}),10000));return rows(raw)}
async function loadFY(force=false){setFYState();if(routeNow()!=='discover')return false;if(fyTask&&!force)return fyTask;const token=++fyToken;paintFYLoading();fyTask=(async()=>{try{if(!(await waitAuth()))throw new Error('Sessão ainda não pronta.');const specs=[...FY_KINDS.map(k=>['watch',k]),...FY_KINDS.map(k=>['fresh',k])];let next=freshState();for(const delay of [0,350,900]){if(delay)await sleep(delay);if(token!==fyToken||routeNow()!=='discover')return false;const rs=await Promise.allSettled(specs.map(([g,k])=>fetchPool(g,k)));next=freshState();rs.forEach((r,i)=>{if(r.status==='fulfilled')next[specs[i][0]][specs[i][1]]=rows(r.value)});if(FY_KINDS.some(k=>next.watch[k].length||next.fresh[k].length))break}if(token!==fyToken||routeNow()!=='discover')return false;if(!FY_KINDS.some(k=>next.watch[k].length||next.fresh[k].length))throw new Error('Nenhuma indicação elegível foi retornada.');fy=next;chooseDaily();paintFY();document.documentElement.dataset.ct465PoolCounts=JSON.stringify({watch:Object.fromEntries(FY_KINDS.map(k=>[k,fy.watch[k].length])),fresh:Object.fromEntries(FY_KINDS.map(k=>[k,fy.fresh[k].length]))});return true}catch(e){if(token===fyToken&&routeNow()==='discover')paintFYFailure(String(e?.message||'Falha ao carregar recomendações.'));return false}finally{if(token===fyToken)fyTask=null}})();return fyTask}
function excluded(slot){if(!fyExcluded.has(slot))fyExcluded.set(slot,new Set());return fyExcluded.get(slot)}
function swapFY(slot){if(fyLocks.has(slot))return false;fyLocks.add(slot);try{const cur=current(slot),curKey=mediaKey(cur),ex=excluded(slot);if(curKey)ex.add(curKey);const pool=slot==='daily'?[...fy.fresh.movie,...fy.fresh.series,...fy.fresh.anime]:rows(fy[slot.split(':')[0]]?.[slot.split(':')[1]]);if(pool.length<2)return false;let pick=null;for(let step=1;step<=pool.length;step++){const candidate=pool[step%pool.length],key=mediaKey(candidate);if(key&&key!==curKey&&!ex.has(key)){pick=candidate;break}}if(!pick){ex.clear();pick=pool.find(x=>mediaKey(x)&&mediaKey(x)!==curKey)||null}if(!pick)return false;const key=mediaKey(pick);ex.add(key);if(slot==='daily')fy.daily=[pick];else{const[g,k]=slot.split(':'),i=fy[g][k].findIndex(x=>mediaKey(x)===key);fy.idx[g][k]=Math.max(0,i)}paintFY();return true}finally{fyLocks.delete(slot)}}
function removeFY(key,mode){fy.daily=fy.daily.filter(x=>mediaKey(x)!==key);for(const k of FY_KINDS){if(mode==='seen')fy.watch[k]=fy.watch[k].filter(x=>mediaKey(x)!==key);fy.fresh[k]=fy.fresh[k].filter(x=>mediaKey(x)!==key);fy.idx.watch[k]=0;fy.idx.fresh[k]=0}if(!fy.daily.length)chooseDaily()}
async function actFY(action,slot){if(action==='swap')return swapFY(slot);if(fyLocks.has(slot))return false;const x=current(slot),key=mediaKey(x);if(!key)return false;fyLocks.add(slot);const before=typeof structuredClone==='function'?structuredClone(fy):JSON.parse(JSON.stringify(fy));try{removeFY(key,action);paintFY();const ok=await Promise.resolve(window.__ctR365?.persistDirect?.(action,key));if(ok===false)throw new Error('PERSIST_FAILED');return true}catch{fy=before;paintFY();return false}finally{fyLocks.delete(slot)}}

/* PROFILE: exactly 13 visible cards; actors use a dedicated source because v380 only returns 10. */
const PROFILE_LIMIT=13;
let profileRun=0,actorsTask=null;
function panelTitle(panel){return q('.panel-head h2,.panel-head h3,:scope>h2,:scope>h3,h2,h3',panel)?.textContent||''}
function wantedPanel(panel){const t=norm(panelTitle(panel));return['series','filmes','series favoritas','filmes favoritos','atores','atores favoritos'].includes(t)}
