function unwrap(v){let x=v;for(let i=0;i<3;i++){if(Array.isArray(x)&&x.length===1&&x[0]&&typeof x[0]==='object'){x=x[0];continue}if(x&&typeof x==='object'&&!Array.isArray(x)&&Object.prototype.hasOwnProperty.call(x,'data')){x=x.data;continue}break}return x}
function mediaKey(x){const id=num(x?.tmdb_id||x?.source_tmdb_id||x?.id||x?.raw_tmdb?.id);if(!id)return'';return String(x?.media_type||x?.type||x?.media_kind)==='movie'?'movie:'+id:'tv:'+id}
