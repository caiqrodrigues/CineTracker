function cardRow(panel){const candidates=qa('.row,.ct424-profile-list,[class*="rail"],[class*="row"]',panel);let best=null,bestN=-1;for(const r of candidates){const n=qa(':scope>*',r).filter(el=>!el.matches?.('[data-ct465-more],[data-ct455-more],[data-ct424-more]')&&(el.matches?.('.card,[data-media-id],[data-person-id],article')||q('.poster,img,[class*="poster"],[class*="avatar"]',el))).length;if(n>bestN){best=r;bestN=n}}return best}
function cardsIn(row){return qa(':scope>*',row).filter(el=>!el.matches?.('[data-ct465-more],[data-ct455-more],[data-ct424-more]')&&(el.matches?.('.card,[data-media-id],[data-person-id],article')||q('.poster,img,[class*="poster"],[class*="avatar"]',el)))}
function nativeMore(panel){return qa('button',panel).find(b=>!b.dataset.ct465More&&norm(b.textContent).includes('ver mais'))||null}
function headerCount(panel){const s=q('.panel-head small',panel)?.textContent||'';const m=String(s).match(/\d[\d.]*/);return m?num(m[0].replaceAll('.','')):0}
function makeMore(panel,row,total){const more=document.createElement('button');more.type='button';more.dataset.ct465More='1';more.className='ct465-profile-more';more.setAttribute('aria-label','Ver mais '+panelTitle(panel));more.innerHTML='<span aria-hidden="true">›</span><small>Ver mais</small>';const trigger=nativeMore(panel);if(trigger)trigger.style.display='none';more.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();if(trigger?.isConnected){trigger.click();return}for(const c of cardsIn(row)){c.hidden=false;c.style.display=''}more.remove()});row.appendChild(more);panel.dataset.ct465ProfileLimit='13+more';panel.dataset.ct465Total=String(total);return more}
function applyPanel(panel){if(!wantedPanel(panel))return false;const row=cardRow(panel);if(!row)return false;qa('[data-ct465-more],[data-ct455-more],[data-ct424-more]',panel).forEach(x=>x.remove());const cards=cardsIn(row),total=Math.max(headerCount(panel),cards.length);for(const [i,c] of cards.entries()){c.hidden=i>=PROFILE_LIMIT;c.style.display=i>=PROFILE_LIMIT?'none':''}const trigger=nativeMore(panel);if(trigger)trigger.style.display='none';if(total>PROFILE_LIMIT)makeMore(panel,row,total);panel.dataset.ct465ProfileLimit=total>PROFILE_LIMIT?'13+more':'all';return true}
function actorCard(a){const id=num(a?.tmdb_person_id),path=String(a?.profile_path||''),src=path?(typeof img==='function'?img(path,'w185'):path):'';return'<article class="card" data-person-id="'+id+'"><button type="button" data-person="'+id+'"><div class="poster"'+(src?' style="background-image:url(\''+esc(src)+'\')"':'')+'></div><div class="card-body"><b>'+esc(a?.actor_name||'Ator')+'</b><small>Ator favorito</small></div></button></article>'}
async function hydrateActors(){if(routeNow()!=='profile'||actorsTask)return actorsTask||false;actorsTask=(async()=>{try{if(!(await waitAuth()))return false;const raw=unwrap(await timeout(rpcCall('cinetracker_profile_actors_v465',{p_limit:14}),7000)),list=rows(raw?.rows),total=num(raw?.count);if(routeNow()!=='profile'||!list.length)return false;const root=visibleOne('[data-profile]')||q('[data-profile]');if(!root)return false;const panel=qa('section.panel,.panel',root).find(p=>['atores','atores favoritos'].includes(norm(panelTitle(p))));if(!panel)return false;const row=cardRow(panel);if(!row)return false;row.innerHTML=list.slice(0,PROFILE_LIMIT).map(actorCard).join('');const small=q('.panel-head small',panel);if(small)small.textContent=String(total);if(total>PROFILE_LIMIT)makeMore(panel,row,total);panel.dataset.ct465Actors=String(list.length)+'/'+String(total);return true}catch(e){document.documentElement.dataset.ct465ActorsError=String(e?.message||e);return false}finally{actorsTask=null}})();return actorsTask}
function applyProfile(){if(routeNow()!=='profile')return false;const root=visibleOne('[data-profile]')||q('[data-profile]');if(!root)return false;let ok=false;for(const panel of qa('section.panel,.panel',root))if(applyPanel(panel))ok=true;void hydrateActors();root.dataset.ct465Profile='13+more';return ok}
function scheduleProfile(){const run=++profileRun;for(const ms of [0,120,350,800,1600,3000,5200])setTimeout(()=>{if(run===profileRun&&routeNow()==='profile')applyProfile()},ms)}

/* DAILY HISTORY: small undo on the same item row and exact RPC per type. */
const dayFmt=v=>{try{return new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date(v))}catch{return''}};
