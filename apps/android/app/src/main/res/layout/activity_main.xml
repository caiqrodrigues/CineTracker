<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#090909" />

    <LinearLayout
        android:id="@+id/android_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0D0D0D"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <Button android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌂\nHome" android:textAllCaps="false" android:textSize="9sp" android:textColor="#F2F2F2" android:background="#0D0D0D" />
        <Button android:id="@+id/nav_discover" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="✦\nDescobrir" android:textAllCaps="false" android:textSize="8sp" android:textColor="#F2F2F2" android:background="#0D0D0D" />
        <Button android:id="@+id/nav_history" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0" android:visibility="gone" android:text="Histórico" />
        <Button android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="●\nPerfil" android:textAllCaps="false" android:textSize="9sp" android:textColor="#F2F2F2" android:background="#0D0D0D" />
        <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⚙\nConfig." android:textAllCaps="false" android:textSize="8sp" android:textColor="#F2F2F2" android:background="#0D0D0D" />
    </LinearLayout>
</LinearLayout>
